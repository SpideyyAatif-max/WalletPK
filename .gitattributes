# Normalise line endings in the repository; check out with the OS default
* text=auto

# Windows-only files keep CRLF
*.sln   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Unix scripts and container files keep LF (they run inside Linux containers)
*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files
*.pdf   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary
