{
  "uid": "walletpk-sagas",
  "title": "WalletPK - Sagas",
  "description": "The Saga engine (M6.3): states, transitions, timers and dead letters, per Saga type. Open one in the Saga explorer (/ops/sagas).",
  "tags": [
    "walletpk"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "WalletPK",
      "type": "dashboards",
      "tags": [
        "walletpk"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "Running Sagas by type and state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 24,
        "h": 9,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (saga_type, state) (max by (job, saga_type, state) (walletpk_sagas_active))",
          "legendFormat": "{{saga_type}} {{state}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Started per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (saga_type) (rate(walletpk_sagas_started_total[5m])) * 60",
          "legendFormat": "{{saga_type}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
