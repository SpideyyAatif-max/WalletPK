{
  "uid": "walletpk-overview",
  "title": "WalletPK - Operations overview",
  "description": "Live operations (proposal 12.2): TPS, success rate, p95 latency per service, active Sagas by state, fraud decisions, ledger health and reconciliation breaks.",
  "tags": [
    "walletpk"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, job)",
          "refId": "service"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, job)",
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "WalletPK",
      "type": "dashboards",
      "tags": [
        "walletpk"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Transactions per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(walletpk_ledger_journals_posted_total[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "API success rate",
