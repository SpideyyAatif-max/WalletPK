{
  "uid": "walletpk-providers",
  "title": "WalletPK - Providers",
  "description": "Calls to outside systems through Polly (timeouts, retries, circuit breakers): Raast banks, billers and mobile networks.",
  "tags": [
    "walletpk"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "WalletPK",
      "type": "dashboards",
      "tags": [
        "walletpk"
      ],
