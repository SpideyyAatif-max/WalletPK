<Project>
  <!-- Inherit the root settings, then mark every project under tests/ as a non-shipping test project -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are self-hosting executables (Microsoft Testing Platform) -->
    <OutputType>Exe</OutputType>
    <!-- CA1707: test names like Transfer_fails_when_balance_is_low are allowed.
         CA1515: xUnit requires public test classes. -->
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>
</Project>
