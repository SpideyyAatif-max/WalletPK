          },
          "status": {
            "type": "string"
          },
          "since": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "BankTransferRequest": {
        "required": [
          "toIban",
          "amountPaisa",
          "beneficiaryTitle",
          "note"
        ],
        "type": "object",
        "properties": {
          "toIban": {
            "type": [
              "null",
              "string"
            ]
          },
          "amountPaisa": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "beneficiaryTitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
