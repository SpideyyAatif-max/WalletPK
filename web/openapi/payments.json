            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "amountPaisa": {
            "type": "integer",
            "format": "int64"
          },
          "toIban": {
            "type": "string"
          },
          "toBank": {
            "type": "string"
          },
          "toBankName": {
            "type": "string"
          },
          "beneficiaryTitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "raastReference": {
            "type": [
              "null",
              "string"
            ]
