        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int32"
          },
          "state": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BankTransferView": {
        "required": [
          "id",
          "status",
          "step",
          "amountPaisa",
          "toIban",
          "toBank",
          "toBankName",
          "beneficiaryTitle",
          "note",
          "raastReference",
          "failureCode",
          "failureReason",
          "requestedAt",
          "updatedAt",
          "completedAt",
          "timeline"
        ],
        "type": "object",
        "properties": {
