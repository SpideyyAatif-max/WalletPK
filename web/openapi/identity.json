  "components": {
    "schemas": {
      "AuthTokens": {
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "refreshToken",
          "refreshTokenExpiresIn",
          "userId",
          "deviceId",
          "coolingOffUntil"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int32"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresIn": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "deviceId": {
            "$ref": "#/components/schemas/DeviceId"
          },
          "coolingOffUntil": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ConfirmMpinRequest": {
        "required": [
          "mpin",
          "idempotencyKey"
        ],
        "type": "object",
        "properties": {
          "mpin": {
            "type": [
              "null",
              "string"
            ]
          },
          "idempotencyKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DeviceId": {
        "type": "string",
        "format": "uuid"
      },
      "DeviceStatus": {
        "enum": [
          "Trusted",
          "Revoked"
        ]
      },
      "DeviceSummary": {
        "required": [
          "deviceId",
          "name",
          "status",
          "trustedAt",
          "lastSeenAt",
          "coolingOffUntil",
          "isCurrent"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "$ref": "#/components/schemas/DeviceId"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DeviceStatus"
          },
          "trustedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "coolingOffUntil": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean"
          }
        }
      },
      "DevRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "KycStatus": {
        "required": [
          "kycTier",
          "verified",
          "cnicMasked",
          "fullName",
          "verifiedAt"
        ],
        "type": "object",
        "properties": {
          "kycTier": {
            "$ref": "#/components/schemas/KycTier"
          },
          "verified": {
            "type": "boolean"
          },
          "cnicMasked": {
            "type": [
              "null",
              "string"
            ]
          },
          "fullName": {
            "type": [
              "null",
              "string"
            ]
          },
          "verifiedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "KycTier": {
        "enum": [
          "L0",
          "L1",
          "L2"
        ]
      },
      "LimitsSummary": {
        "required": [
          "kycTier",
          "perTransaction",
          "daily",
          "monthly",
          "maxBalance",
          "coolingOffUntil"
        ],
        "type": "object",
        "properties": {
          "kycTier": {
            "$ref": "#/components/schemas/KycTier"
          },
          "perTransaction": {
            "$ref": "#/components/schemas/Money"
          },
          "daily": {
            "$ref": "#/components/schemas/LimitUsageView"
          },
          "monthly": {
