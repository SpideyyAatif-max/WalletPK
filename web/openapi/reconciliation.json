  "components": {
    "schemas": {
      "AuditEntry": {
        "required": [
          "sequence",
          "actor",
          "action",
          "subject",
          "details",
          "at",
          "previousHash",
          "hash"
        ],
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "previousHash": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        }
      },
      "AuditVerification": {
        "required": [
          "intact",
          "entries",
          "brokenAt",
          "headHash"
        ],
        "type": "object",
        "properties": {
          "intact": {
            "type": "boolean"
          },
          "entries": {
            "type": "integer",
            "format": "int64"
          },
          "brokenAt": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "headHash": {
            "type": "string"
          }
        }
      },
      "BreakDetail": {
        "required": [
          "break",
          "payment",
          "history"
        ],
        "type": "object",
        "properties": {
          "break": {
            "$ref": "#/components/schemas/ReconBreak"
          },
          "payment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ExternalPayment"
              }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          }
        }
      },
      "BreakNoteRequest": {
        "required": [
          "note"
        ],
        "type": "object",
        "properties": {
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DayOverview": {
        "required": [
          "date",
          "reconciled",
          "failed",
          "lines",
          "matched",
          "breaks",
          "providerTotalPaisa",
          "ourTotalPaisa"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "reconciled": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          },
          "lines": {
            "type": "integer",
            "format": "int32"
          },
          "matched": {
            "type": "integer",
            "format": "int32"
          },
          "breaks": {
            "type": "integer",
            "format": "int32"
          },
          "providerTotalPaisa": {
            "type": "integer",
            "format": "int64"
          },
          "ourTotalPaisa": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DaySummary": {
        "required": [
          "date",
          "parties",
          "lines",
          "matched",
          "breaks",
          "openBreaks",
          "providerTotalPaisa",
          "ourTotalPaisa"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "parties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartyDay"
            }
          },
          "lines": {
            "type": "integer",
            "format": "int32"
          },
          "matched": {
            "type": "integer",
            "format": "int32"
          },
          "breaks": {
            "type": "integer",
            "format": "int32"
          },
          "openBreaks": {
            "type": "integer",
            "format": "int32"
          },
          "providerTotalPaisa": {
            "type": "integer",
            "format": "int64"
          },
          "ourTotalPaisa": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ExternalPayment": {
        "required": [
          "id",
          "kind",
          "party",
          "userId",
          "providerReference",
          "amountPaisa",
          "status",
          "serviceStatus",
          "completedAt",
          "completedOn",
          "updatedAt",
          "firstSeenAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "party": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "providerReference": {
            "type": [
              "null",
              "string"
            ]
          },
          "amountPaisa": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "serviceStatus": {
            "type": "string"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "completedOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PartyDay": {
        "required": [
          "party",
          "run",
          "openBreaks"
        ],
        "type": "object",
        "properties": {
          "party": {
            "type": "string"
          },
          "run": {
            "oneOf": [
              {
                "type": "null"
              },
              {
