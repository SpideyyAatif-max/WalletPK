{
  "name": "walletpk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WalletPK web app: customer wallet (/wallet), later the ops console (/ops) and simulation control centre (/sim).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run api:check && npm run test && npm run build",
    "api:fetch": "node scripts/api-types.mjs fetch",
    "api:types": "node scripts/api-types.mjs types",
    "api:check": "node scripts/api-types.mjs check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
