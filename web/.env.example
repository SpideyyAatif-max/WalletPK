# Copy to .env.local for `npm run dev`. Defaults match docker compose on your machine.

# Where the browser reaches the API gateway (REST and the /hubs/wallet SignalR hub).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Where the Next.js server reaches the gateway for /session/* (inside docker compose: http://gateway:8080).
API_URL=http://localhost:5000

# Show the developer tools: the SMS inbox (read OTPs) and test top-ups. Needs the services in Development.
NEXT_PUBLIC_DEV_TOOLS=true
