<Project>
  <!--
    Central Package Management: every NuGet package version used anywhere in WalletPK is declared here, once.
    Projects reference packages WITHOUT a version: <PackageReference Include="Npgsql" />
    Versions are added module by module as each package is first needed.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core and EF Core">
  </ItemGroup>

  <ItemGroup Label="Data, cache and messaging">
  </ItemGroup>

  <ItemGroup Label="Resilience and Sagas">
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- OpenTelemetry core packages must share one version -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xUnit v3 4.x runs on Microsoft Testing Platform v2 (opted in via global.json "test.runner") -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>
</Project>
