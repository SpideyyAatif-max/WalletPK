{
  "Jwt": {
    "RequireHttpsMetadata": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 100
  },
  "ReverseProxy": {
    "Routes": {
      "identity-dev": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/identity/dev/{**catch-all}"
        },
        "Order": 1
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Webhooks": {
    "Secrets": {
      "raast": "dev-only-raast-webhook-secret",
      "billers": "dev-only-billers-webhook-secret"
    }
  }
}
