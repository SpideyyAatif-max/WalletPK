{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Yarp": "Warning",
        "Yarp.ReverseProxy.Health": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "RateLimiting": {
    "PerIpTokenLimit": 200,
    "PerIpTokensPerSecond": 100,
    "PerUserTokenLimit": 60,
    "PerUserTokensPerSecond": 20,
    "PerDeviceTokenLimit": 60,
    "PerDeviceTokensPerSecond": 20,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Webhooks": {
    "ToleranceSeconds": 300,
    "MaxBodyBytes": 1048576,
    "Secrets": {}
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/identity/auth/{**catch-all}"
        },
        "Order": 1,
        "RateLimiterPolicy": "auth"
      },
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Order": 10
      },
      "wallets": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/wallets/{**catch-all}"
        }
      },
      "ledger-operations": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "operations",
        "Match": {
          "Path": "/api/ledger/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "bills": {
        "ClusterId": "bills",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/bills/{**catch-all}"
        }
      },
      "topups": {
        "ClusterId": "topup-merchant",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/topups/{**catch-all}"
        }
      },
      "merchants": {
        "ClusterId": "topup-merchant",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/merchants/{**catch-all}"
        }
      },
      "agents": {
        "ClusterId": "agents",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/agents/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "hubs": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "fraud": {
        "ClusterId": "fraud",
        "AuthorizationPolicy": "operations",
        "Match": {
          "Path": "/api/fraud/{**catch-all}"
        }
      },
      "reconciliation": {
        "ClusterId": "reconciliation",
        "AuthorizationPolicy": "operations",
        "Match": {
          "Path": "/api/reconciliation/{**catch-all}"
        }
      },
      "simulation": {
        "ClusterId": "simulation",
        "AuthorizationPolicy": "operations",
        "Match": {
          "Path": "/api/simulation/{**catch-all}"
        }
      },
      "webhooks-raast": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/webhooks/raast/{**catch-all}"
        }
      },
      "webhooks-billers": {
        "ClusterId": "bills",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/webhooks/billers/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "ledger": {
