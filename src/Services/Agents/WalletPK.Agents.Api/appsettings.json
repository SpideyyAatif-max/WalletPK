{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AgentsDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Agents": {
    "MinimumKycTier": "L1",
    "AutoApprove": false,
    "CashOutCodeKey": "",
    "Transactions": {
      "LedgerReplyTimeoutSeconds": 30,
      "MaxLedgerResends": 60
    },
    "Payouts": {
      "Enabled": true,
      "RunAt": "01:00",
      "PollSeconds": 60,
      "ResendMinutes": 10
    }
  },
  "Sagas": {
    "Timers": {
      "Enabled": true,
      "BatchSize": 50,
      "MaxParallelism": 16,
      "PollIntervalMilliseconds": 250,
      "LeaseSeconds": 60,
      "StepTimeoutSeconds": 45,
      "RetryDelaySeconds": 10
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "BatchSize": 200,
      "PollIntervalMilliseconds": 100,
      "RetentionHours": 72,
      "MaxBackoffSeconds": 300
    }
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
