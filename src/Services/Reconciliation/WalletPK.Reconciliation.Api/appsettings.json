{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ReconciliationDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Reconciliation": {
    "Parties": [],
    "StartFromLatest": false,
    "Schedule": {
      "Enabled": true,
      "DailyAt": "00:30",
      "PollSeconds": 60,
      "RetryMinutes": 15
    }
  },
  "Providers": {
    "Settlement": {
      "BaseUrl": "http://localhost:5200/",
      "ApiKey": "",
      "TimeoutSeconds": 30
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
