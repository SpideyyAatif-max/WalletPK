{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Otp": {
    "Length": 6,
    "TimeToLiveSeconds": 120,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 30,
    "Pepper": ""
  },
