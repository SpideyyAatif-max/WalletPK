{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TopupMerchantDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "TopUps": {
    "HoldLifetimeHours": 72,
    "LedgerReplyTimeoutSeconds": 60,
    "MaxLedgerResends": 60,
    "MaxAttempts": 5,
    "RetryInitialSeconds": 5,
    "RetryMaxSeconds": 60,
    "MaxRetryMinutes": 10,
    "VerifyDelaySeconds": 5,
    "VerifyMaxSeconds": 300,
    "MaxVerifyHours": 24
  },
  "Merchants": {
    "Qr": {
      "SigningKey": ""
    },
    "Payments": {
      "LedgerReplyTimeoutSeconds": 30,
      "MaxLedgerResends": 60
    },
    "Settlement": {
      "Enabled": true,
      "RunAt": "00:30",
      "PollSeconds": 60,
      "ResendMinutes": 10
    }
  },
  "Providers": {
    "Telcos": {
      "BaseUrl": "http://localhost:5200/",
      "ApiKey": "",
      "Resilience": {
        "MaxConcurrentCalls": 32,
        "MaxQueuedCalls": 64,
        "TotalTimeoutMilliseconds": 15000,
        "AttemptTimeoutMilliseconds": 4000,
        "MaxRetries": 2,
        "RetryBaseDelayMilliseconds": 200,
        "FailureRatio": 0.5,
        "MinimumThroughput": 5,
        "SamplingSeconds": 30,
        "BreakSeconds": 30
      }
    }
  },
  "Sagas": {
    "Timers": {
      "Enabled": true,
      "BatchSize": 50,
      "MaxParallelism": 16,
      "PollIntervalMilliseconds": 250,
      "LeaseSeconds": 60,
      "StepTimeoutSeconds": 45,
      "RetryDelaySeconds": 10
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "BatchSize": 200,
      "PollIntervalMilliseconds": 100,
      "RetentionHours": 72,
      "MaxBackoffSeconds": 300
    }
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
