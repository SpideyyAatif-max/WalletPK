<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WalletPK.TopupMerchant.Infrastructure</RootNamespace>
    <Description>Top-up &amp; Merchant adapters: PostgreSQL via EF Core (outbox, inbox, Saga tables, merchants, QR codes, settlements), Kafka, the telco client with a resilience pipeline per network, Ledger reply handlers, and the nightly settlement job.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WalletPK.TopupMerchant.Application\WalletPK.TopupMerchant.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Web\WalletPK.Web.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Persistence\WalletPK.Persistence.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Messaging.Kafka\WalletPK.Messaging.Kafka.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Resilience\WalletPK.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WalletPK.TopupMerchant.UnitTests" />
    <InternalsVisibleTo Include="WalletPK.TopupMerchant.IntegrationTests" />
  </ItemGroup>

</Project>
