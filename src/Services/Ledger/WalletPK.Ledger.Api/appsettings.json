{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LedgerDb": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Ledger": {
    "Locks": {
      "TimeToLiveMilliseconds": 10000,
      "WaitMilliseconds": 3000
    },
    "Idempotency": {
      "RetentionHours": 24,
      "InProgressTimeoutSeconds": 60
    },
    "Maintenance": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "HoldBatchSize": 200
    }
  }
}
