{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LedgerDb": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Ledger": {
    "Locks": {
      "TimeToLiveMilliseconds": 10000,
      "WaitMilliseconds": 3000
    },
    "Idempotency": {
      "RetentionHours": 24,
      "InProgressTimeoutSeconds": 60
    },
    "Maintenance": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "HoldBatchSize": 200
    },
    "Audit": {
      "SealingEnabled": true,
      "SealIntervalMilliseconds": 2000,
      "BatchSize": 500,
      "MaxUnsealedAgeSeconds": 300
    },
    "Invariants": {
      "Enabled": true,
      "IntervalMinutes": 15
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Services": {
    "IdentityGrpc": {
      "Address": "http://localhost:5201",
      "TimeoutMilliseconds": 3000
    }
  },
  "Fees": {
    "TaxPercent": 16,
    "Schedules": {
      "P2PTransfer": [
        {
          "UpToRupees": 1000,
          "FlatRupees": 0
        },
        {
          "Percent": 0.5,
          "MinRupees": 5,
          "MaxRupees": 50
        }
      ]
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "BatchSize": 200,
      "PollIntervalMilliseconds": 250,
      "RetentionHours": 72,
      "MaxBackoffSeconds": 300
    }
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
