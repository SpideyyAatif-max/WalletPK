{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FraudDb": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Fraud": {
    "StepUpAt": 30,
    "ReviewAt": 60,
    "BlockAt": 90,
    "AlertAt": 40,
    "RingWindowMinutes": 10,
    "RingMinSenders": 5,
    "RingMinFlagged": 3,
    "RulesPollSeconds": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "BatchSize": 200,
      "PollIntervalMilliseconds": 100,
      "RetentionHours": 72,
      "MaxBackoffSeconds": 300
    }
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
