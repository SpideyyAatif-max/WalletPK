{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationsDb": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Notifications": {
    "SendWindowMinutes": 60,
    "MaxAttempts": 6,
    "RetryInitialSeconds": 5,
    "RetryMaxSeconds": 300,
    "SenderPollMilliseconds": 1000,
    "StartFromLatest": true
  },
  "Providers": {
    "Messaging": {
      "BaseUrl": "http://localhost:5200/",
      "ApiKey": "",
      "Resilience": {
        "MaxConcurrentCalls": 32,
        "MaxQueuedCalls": 64,
        "TotalTimeoutMilliseconds": 15000,
        "AttemptTimeoutMilliseconds": 4000,
        "MaxRetries": 2,
        "RetryBaseDelayMilliseconds": 200,
        "FailureRatio": 0.5,
        "MinimumThroughput": 5,
        "SamplingSeconds": 30,
        "BreakSeconds": 30
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "BatchSize": 200,
      "PollIntervalMilliseconds": 100,
      "RetentionHours": 72,
      "MaxBackoffSeconds": 300
    }
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
