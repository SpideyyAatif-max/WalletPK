{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BillsDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Bills": {
    "Payments": {
      "HoldLifetimeHours": 168,
      "LedgerReplyTimeoutSeconds": 60,
      "MaxLedgerResends": 60,
      "MaxPayAttempts": 5,
      "RetryInitialSeconds": 10,
      "RetryMaxSeconds": 120,
      "MaxRetryMinutes": 30,
      "VerifyDelaySeconds": 5,
      "VerifyMaxSeconds": 60,
      "FastVerifyMinutes": 10,
      "PendingCheckSeconds": 600,
      "MaxPendingHours": 48
    },
    "Reminders": {
      "Enabled": true,
      "PollSeconds": 300,
      "BatchSize": 100,
      "CheckIntervalHours": 12,
      "RetryMinutes": 60,
      "DaysBefore": 3
    }
  },
  "Providers": {
    "Billers": {
      "BaseUrl": "http://localhost:5200/",
      "ApiKey": "",
      "Resilience": {
        "MaxConcurrentCalls": 32,
        "MaxQueuedCalls": 64,
        "TotalTimeoutMilliseconds": 15000,
        "AttemptTimeoutMilliseconds": 4000,
        "MaxRetries": 2,
        "RetryBaseDelayMilliseconds": 200,
        "FailureRatio": 0.5,
        "MinimumThroughput": 5,
        "SamplingSeconds": 30,
        "BreakSeconds": 30
      }
    }
  },
  "Sagas": {
    "Timers": {
      "Enabled": true,
      "BatchSize": 50,
      "MaxParallelism": 16,
      "PollIntervalMilliseconds": 250,
      "LeaseSeconds": 60,
      "StepTimeoutSeconds": 45,
      "RetryDelaySeconds": 10
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "BatchSize": 200,
      "PollIntervalMilliseconds": 100,
      "RetentionHours": 72,
      "MaxBackoffSeconds": 300
    }
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
