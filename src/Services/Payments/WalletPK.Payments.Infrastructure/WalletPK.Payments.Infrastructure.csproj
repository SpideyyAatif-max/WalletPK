<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WalletPK.Payments.Infrastructure</RootNamespace>
    <Description>Payments adapters: PostgreSQL via EF Core (outbox, inbox, Saga tables), Kafka, and the Raast client with a resilience pipeline per bank (Polly: bulkhead, timeouts, retries with jitter, circuit breaker).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WalletPK.Payments.Application\WalletPK.Payments.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Web\WalletPK.Web.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Persistence\WalletPK.Persistence.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Messaging.Kafka\WalletPK.Messaging.Kafka.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Resilience\WalletPK.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WalletPK.Payments.UnitTests" />
    <InternalsVisibleTo Include="WalletPK.Payments.IntegrationTests" />
  </ItemGroup>

</Project>
