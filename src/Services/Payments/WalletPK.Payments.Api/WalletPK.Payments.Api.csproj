<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>WalletPK.Payments.Api</RootNamespace>
    <Description>WalletPK Payments service: bank transfers over Raast (a Saga per transfer), beneficiary lookup, bank availability and Raast's callbacks.</Description>
    <UserSecretsId>walletpk-payments</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed only by the dotnet-ef tool (migrations); not shipped with the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WalletPK.Payments.Infrastructure\WalletPK.Payments.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Web\WalletPK.Web.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\WalletPK.Observability\WalletPK.Observability.csproj" />
  </ItemGroup>

</Project>
