{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentsDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Authority": "http://localhost:5101/",
    "Issuer": "walletpk-identity",
    "Audience": "walletpk-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "Payments": {
    "BankTransfers": {
      "HoldLifetimeHours": 168,
      "LedgerReplyTimeoutSeconds": 60,
      "MaxLedgerResends": 60,
      "QueueRetryInitialSeconds": 15,
      "QueueRetryMaxSeconds": 300,
      "MaxQueueHours": 24,
      "VerifyDelaySeconds": 5,
      "StatusCheckInitialSeconds": 30,
      "StatusCheckMaxSeconds": 600,
      "MaxWaitHours": 48,
      "SenderName": "WalletPK"
    }
  },
  "Providers": {
    "Raast": {
      "BaseUrl": "http://localhost:5200/",
      "ApiKey": "",
      "Resilience": {
        "MaxConcurrentCalls": 32,
        "MaxQueuedCalls": 64,
        "TotalTimeoutMilliseconds": 15000,
        "AttemptTimeoutMilliseconds": 4000,
        "MaxRetries": 2,
        "RetryBaseDelayMilliseconds": 200,
        "FailureRatio": 0.5,
        "MinimumThroughput": 5,
        "SamplingSeconds": 30,
        "BreakSeconds": 30
      }
    }
  },
  "Webhooks": {
    "Raast": {
      "Secret": "",
      "ToleranceSeconds": 300
    }
  },
  "Sagas": {
    "Timers": {
      "Enabled": true,
      "BatchSize": 50,
      "MaxParallelism": 16,
      "PollIntervalMilliseconds": 250,
      "LeaseSeconds": 60,
      "StepTimeoutSeconds": 45,
      "RetryDelaySeconds": 10
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "EnsureTopics": false
  },
  "Outbox": {
    "Relay": {
      "Enabled": true,
      "BatchSize": 200,
      "PollIntervalMilliseconds": 100,
      "RetentionHours": 72,
      "MaxBackoffSeconds": 300
    }
  },
  "Inbox": {
    "RetentionDays": 35
  }
}
